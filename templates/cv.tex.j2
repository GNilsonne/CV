<% if academic_commissions %>
\section{Academic Commissions of Trust}
\begin{itemize}[nolistsep]
<% for c in academic_commissions %>
    \item << c.description|autolink >>
    <% if c.subitems %>
    \begin{itemize}[nolistsep]
    <% for sub in c.subitems %>
        \item << sub|autolink >>
    <% endfor %>
    \end{itemize}
    <% endif %>
