<% endfor %>
\end{itemize}
<% endif %>

%% ================================================================
%% TEACHING
%% ================================================================
<% if teaching %>
\section{Teaching}
\begin{itemize}[nolistsep]
<% for t in teaching %>
    \item << t.description|autolink >>
<% if t.subitems is defined and t.subitems %>
    \begin{itemize}[nolistsep]
<% for sub in t.subitems %>
        \item << sub|autolink >>
<% endfor %>
    \end{itemize}
<% endif %>
<% endfor %>
\end{itemize}
<% endif %>

%% ================================================================
%% AWARDS
%% ================================================================
<% if awards %>
\section{Awards}
\begin{itemize}[nolistsep]
<% for a in awards %>
