\documentclass[10pt,a4paper]{article}

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{libertinus}
\usepackage[margin=2cm]{geometry}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{xcolor}
\usepackage[hyphens]{url}
\usepackage{xurl}
\usepackage[colorlinks,breaklinks=true]{hyperref}

% Link styling
\hypersetup{
    urlcolor=blue!70!black,
    linkcolor=blue!70!black,
    citecolor=blue!70!black,
}

% Section formatting
\titleformat{\section}{\large\bfseries\scshape}{}{0em}{}[\titlerule]
\titlespacing*{\section}{0pt}{1.5ex plus .5ex minus .2ex}{1ex plus .2ex}

\titleformat{\subsection}{\normalsize\bfseries}{}{0em}{}
\titlespacing*{\subsection}{0pt}{1ex plus .3ex minus .1ex}{0.5ex plus .1ex}

% Compact lists — aligned left margins
\setlist[enumerate]{leftmargin=2.5em, labelsep=0.5em, itemsep=0.3ex, parsep=0ex, topsep=0.5ex}
\setlist[itemize]{leftmargin=2.5em, itemsep=0.3ex, parsep=0ex, topsep=0.5ex}
\setlist[itemize,2]{leftmargin=1.5em, itemsep=0.2ex, parsep=0ex, topsep=0.3ex, before=\small}

% Allow sloppy line breaking to prevent overfull hboxes with URLs
\sloppy

\begin{document}

% Header
\begin{center}
    {\LARGE\bfseries << meta.name|tex >>}\\[0.5em]
    << meta.affiliation|tex >>\\
    <% if meta.email %>\href{mailto:<< meta.email >>}{<< meta.email|tex >>}<% endif %>\\
    ORCID: \href{https://orcid.org/<< meta.orcid >>}{<< meta.orcid >>}
    <% if meta.profiles %>\\
    <% if meta.profiles.github %>GitHub: \href{<< meta.profiles.github >>}{GNilsonne}<% endif %>
    <% if meta.profiles.google_scholar %> $\cdot$ Google Scholar: \href{<< meta.profiles.google_scholar >>}{mXzy9UIAAAAJ}<% endif %>
    <% endif %>
\end{center}

\vspace{0.5em}

%% ================================================================
%% DEGREES
%% ================================================================
<% if degrees %>
\section{Degrees and Qualifications}
\begin{itemize}[nolistsep]
<% for deg in degrees %>
    \item << deg.description|autolink >><% if deg.link %> \href{<< deg.link >>}{[link]}<% endif %>
<% endfor %>
\end{itemize}
<% endif %>

%% ================================================================
%% EMPLOYMENT
%% ================================================================
<% if employment %>
\section{Employment and Appointments}
\begin{itemize}[nolistsep]
<% for pos in employment %>
    \item << pos.description|autolink >>
<% endfor %>
\end{itemize}
<% endif %>

%% ================================================================
%% PHD SUPERVISION
%% ================================================================
<% if phd_supervision %>
\section{Supervision of PhD Students}
\begin{itemize}[nolistsep]
    \item Supervised students:
    \begin{itemize}[nolistsep]
<% for s in phd_supervision %>
        \item << s.name|tex >>, << s.institution|tex >> << s.year >>, << s.role >>.<% if s.thesis %> Thesis: \emph{<< s.thesis|tex >>}.<% endif %><% if s.link %> \href{<< s.link >>}{[link]}<% endif %>
<% endfor %>
    \end{itemize}
\end{itemize}
<% endif %>

%% ================================================================
%% GRANTS
%% ================================================================
<% if grants %>
\section{Research Grants}
\begin{itemize}[nolistsep]
<% for g in grants %>
